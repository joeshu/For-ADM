{
  "schemaVersion": 1,
  "rawBase": "https://raw.githubusercontent.com/joeshu/For-ADM/master",
  "templates": [
    {
      "id": "yqk-qntv",
      "adapter": "yqk",
      "output": {
        "script": "yqk-qntv/ad-clean.js",
        "conf": "yqk-qntv/quantumult-x-snippet.conf"
      },
      "bindings": [
        {
          "domains": {
            "type": "dated",
            "prefix": "yz(?:y)?\\d{4,6}",
            "wildcard": "yz*",
            "suffixes": [
              "bzy42ezt.com",
              "zazy3mc5.com",
              "7k5jb8t9.com",
              "3nyk7h9o.com",
              "jba2yo1c.com",
              "hzkeka49.com",
              "q8nsderug.com",
              "o5r52at9v.com",
              "tgs2hl4ut.com",
              "goi6lhmry.com",
              "6vh3qyu9x.com"
            ]
          },
          "routes": [
            {
              "kind": "json",
              "path": "/v[12]/api/(?:basic/init|home/(?:body|firstScreen)|adInfo/(?:getPageAd|getTextAd|getSearchAd|getUserCenterAd|getChatAd|getTopicAd)|vodInfo/(?:index|getVodBodyAd|getVodPauseAd))(?:\\?.*)?$"
            }
          ]
        },
        {
          "domains": {
            "type": "numbered",
            "brands": [
              "yqk",
              "qntv"
            ],
            "tld": "app",
            "prefixes": [
              "",
              "www"
            ]
          },
          "routes": [
            {
              "kind": "js",
              "path": "/_nuxt/(?:entry|_play_)\\.[a-zA-Z0-9]+\\.js(?:\\?.*)?$"
            }
          ]
        }
      ],
      "jsonPolicies": [
        {
          "endpoint": "/adInfo/getPageAd$",
          "when": {
            "path": "data",
            "type": "object"
          },
          "ops": [
            {
              "op": "set",
              "path": "data.floatAd",
              "value": null,
              "create": true
            },
            {
              "op": "set",
              "path": "data.popupAd",
              "value": null,
              "create": true
            }
          ]
        },
        {
          "endpoint": "/adInfo/getChatAd$",
          "when": {
            "path": "data",
            "type": "array"
          },
          "ops": [
            {
              "op": "clearArray",
              "path": "data"
            }
          ]
        },
        {
          "endpoint": "/adInfo/getTopicAd$",
          "when": {
            "path": "data.topicAdList",
            "type": "array"
          },
          "ops": [
            {
              "op": "clearArray",
              "path": "data.topicAdList"
            }
          ]
        },
        {
          "endpoint": "/(?:vodInfo/getVodPauseAd|adInfo/getTextAd)$",
          "when": null,
          "ops": [
            {
              "op": "set",
              "path": "data",
              "value": null,
              "create": true
            }
          ]
        },
        {
          "endpoint": "/(?:vodInfo/getVodBodyAd|adInfo/(?:getSearchAd|getUserCenterAd))$",
          "when": {
            "path": "data",
            "type": "array"
          },
          "ops": [
            {
              "op": "clearArray",
              "path": "data"
            }
          ]
        },
        {
          "endpoint": "/vodInfo/index$",
          "when": {
            "path": "data.playerList",
            "type": "array"
          },
          "ops": [
            {
              "op": "set",
              "path": "data.startAd",
              "value": null,
              "create": true
            }
          ]
        },
        {
          "endpoint": "/basic/init$",
          "when": {
            "path": "data.startAdList",
            "type": "array"
          },
          "ops": [
            {
              "op": "clearArray",
              "path": "data.startAdList"
            },
            {
              "op": "set",
              "path": "data.startAdShowTime",
              "value": 0,
              "create": true
            }
          ]
        },
        {
          "endpoint": "/home/body$",
          "when": {
            "path": "data.adList",
            "type": "array"
          },
          "ops": [
            {
              "op": "clearArray",
              "path": "data.adList"
            }
          ]
        },
        {
          "endpoint": "/home/firstScreen$",
          "when": {
            "any": [
              {
                "path": "data.focusAdList",
                "type": "array"
              },
              {
                "path": "data.hotMudleList",
                "type": "array"
              }
            ]
          },
          "ops": [
            {
              "op": "set",
              "path": "data.focusAdList",
              "value": [],
              "create": true
            },
            {
              "op": "filterArray",
              "path": "data.hotMudleList",
              "field": "adAction",
              "numeric": true,
              "exclude": [
                1,
                2,
                8,
                10,
                11
              ]
            }
          ]
        }
      ],
      "jsRules": [
        {
          "asset": "entry",
          "requires": [
            "class:\"startup-ad\"",
            "/adInfo/getPageAd",
            "useHttp={get:"
          ],
          "groups": [
            [
              [
                "m.value=X.value.data.startAdList||[]",
                "m.value=[]"
              ],
              [
                "z.floatAd&&R.name!=\"play-play\"",
                "false&&R.name!=\"play-play\""
              ]
            ]
          ],
          "inject": [
            [
              "transform:r=>typeof r==\"string\"?JSON.parse(r):r",
              "transform:r=>__forAdmYqkClean(r,e)",
              3
            ]
          ]
        },
        {
          "asset": "_play_",
          "requires": [
            "name:\"VideoStartAd\"",
            "getVodPauseAd({vodId:T",
            "getVideoDetail({vodId:T"
          ],
          "groups": [
            [
              [
                "N.value=t.value.data,m.value",
                "N.value=t.value.data,N.value.startAd=null,m.value",
                2
              ],
              [
                "Ga.value=t.value.data,ta.value=!!t.value.data",
                "Ga.value=null,ta.value=!1"
              ],
              [
                "e.result&&(Nt.value=t.value.data)},jt=i()",
                "e.result&&(Nt.value=[])},jt=i()"
              ],
              [
                "e.result&&(jt.value=t.value.data)};let ga=",
                "e.result&&(jt.value=null)};let ga="
              ]
            ]
          ]
        }
      ]
    },
    {
      "id": "ycblcw",
      "adapter": "declarative",
      "output": {
        "script": "ycblcw/ycblcw-ad-clean.js",
        "conf": "ycblcw/quantumult-x-snippet.conf"
      },
      "bindings": [
        {
          "domains": {
            "type": "exact",
            "names": [
              "ycblcw.com"
            ],
            "prefixes": [
              "",
              "www",
              "m"
            ]
          },
          "routes": [
            {
              "kind": "js",
              "path": "/dedg/cs13341\\.js(?:\\?.*)?$"
            },
            {
              "kind": "html",
              "path": "/(?:[^?#]*\\.html)?(?:\\?.*)?$"
            }
          ]
        }
      ],
      "actions": [
        {
          "kind": "js",
          "op": "setBody",
          "value": "/* Dedicated click-overlay and redirect advertising disabled. */"
        },
        {
          "kind": "html",
          "op": "replaceRegex",
          "requires": [
            "/template/buka/"
          ],
          "bodyPattern": "<html[\\s>]",
          "pattern": "<script\\b[^>]*\\bsrc\\s*=\\s*[\"\\'](?:https?:)?(?:\\/\\/(?:www\\.|m\\.)?ycblcw\\.com)?\\/dedg\\/cs13341\\.js(?:\\?[^\"\\']*)?[\"\\'][^>]*>[\\s\\S]*?<\\/script\\s*>",
          "flags": "ig",
          "value": ""
        },
        {
          "kind": "html",
          "op": "replaceRegex",
          "requires": [
            "/template/buka/"
          ],
          "bodyPattern": "<html[\\s>]",
          "pattern": "<a\\b[^>]*\\bhref\\s*=\\s*[\"\\'](?:https?:)?\\/\\/app2\\.zstv47\\.com(?:[/?][^\"\\']*)?[\"\\'][^>]*>[\\s\\S]*?<\\/a\\s*>",
          "flags": "ig",
          "value": ""
        }
      ]
    },
    {
      "id": "souju-ai",
      "adapter": "souju",
      "output": {
        "script": "souju-ai/souju-ad-clean.js",
        "conf": "souju-ai/quantumult-x-snippet.conf"
      },
      "bindings": [
        {
          "domains": {
            "type": "exact",
            "names": [
              "ai.baipiaozhe.com",
              "souju.ai"
            ]
          },
          "routes": [
            {
              "kind": "json",
              "path": "/v1/[^?#]*(?:[?#].*)?$"
            },
            {
              "kind": "js",
              "path": "/assets/(?:global-player-host-[^/?]+|movie-card-runtime-[^/?]+|main-[^/?]+)\\.js(?:[?#].*)?$"
            }
          ]
        }
      ],
      "snapshotWhen": {
        "all": [
          {
            "path": "object",
            "equals": "app.experience_snapshot"
          },
          {
            "path": "placements",
            "type": "object"
          }
        ]
      },
      "snapshotOps": [
        {
          "op": "clearArray",
          "path": "placements.splash_screen.items"
        },
        {
          "op": "clearArray",
          "path": "placements.showcase_grid.items"
        },
        {
          "op": "set",
          "path": "placements.player_info.enabled",
          "value": false,
          "create": true,
          "when": {
            "path": "placements.player_info",
            "type": "object"
          }
        },
        {
          "op": "set",
          "path": "placements.player_info.default_ad_targeting.enabled",
          "value": false,
          "create": true,
          "when": {
            "path": "placements.player_info",
            "type": "object"
          }
        },
        {
          "op": "clearArray",
          "path": "placements.player_info.items"
        },
        {
          "op": "clearArray",
          "path": "placements.player_info.banner_items"
        },
        {
          "op": "clearArray",
          "path": "placements.player_info.grid_items"
        }
      ],
      "components": [
        {
          "prefix": "global-player-host-",
          "name": "Cp",
          "requires": [
            "qr(\"player_info\")",
            "creative_daily_rotation_limit"
          ]
        },
        {
          "prefix": "global-player-host-",
          "name": "ti",
          "requires": [
            "movie-player-info-ad-grid"
          ]
        },
        {
          "prefix": "global-player-host-",
          "name": "qu",
          "requires": [
            "movie-player-info-ad-banner-shell"
          ]
        },
        {
          "prefix": "main-",
          "name": "T0",
          "requires": [
            "app-startup-ad",
            "跳过"
          ]
        }
      ],
      "runtime": {
        "prefix": "movie-card-runtime-",
        "name": "As",
        "requires": [
          "splash_screen",
          "player_info",
          "showcase_grid"
        ],
        "minimum": 3,
        "pairs": [
          [
            "n=en(t.splash_screen,\"banner\")",
            "n=en({...t.splash_screen,items:[]},\"banner\")"
          ],
          [
            "o=en(t.showcase_grid,\"grid\")",
            "o=en({...t.showcase_grid,items:[]},\"grid\")"
          ],
          [
            "u=en({...a,layout:c===\"grid\"?\"grid\":\"banner\"})",
            "u=en({...a,items:[],layout:c===\"grid\"?\"grid\":\"banner\"})"
          ],
          [
            "enabled:a.enabled!==!1",
            "enabled:!1"
          ],
          [
            "banner_items:un(a.banner_items)??u.items",
            "banner_items:[]"
          ],
          [
            "grid_items:un(a.grid_items)??u.items",
            "grid_items:[]"
          ]
        ]
      }
    },
    {
      "id": "4kvm",
      "adapter": "declarative",
      "output": {
        "script": "4kvm/4kvm-ad-clean.js",
        "conf": "4kvm/quantumult-x-snippet.conf"
      },
      "bindings": [
        {
          "domains": {
            "type": "exact",
            "names": [
              "4kvms.org",
              "4kvms.com",
              "4kvm.top",
              "4kvm.cc",
              "4kvm.me",
              "4kvm.org",
              "4kvm.tv",
              "4kvm.net",
              "4kvm.pro",
              "4kvm.com"
            ],
            "prefixes": [
              "",
              "www"
            ]
          },
          "routes": [
            {
              "kind": "js",
              "path": "/static/js/dist/app\\.ultra\\.min\\.[^/?]+\\.js(?:\\?.*)?$"
            },
            {
              "kind": "html",
              "path": "/(?:play/[^/?]+)?(?:\\?.*)?$"
            }
          ]
        }
      ],
      "actions": [
        {
          "kind": "js",
          "op": "replaceRegex",
          "requires": [
            "artplayerPluginAds({"
          ],
          "pattern": "this\\.prerollAdEnabled=!0",
          "value": "this.prerollAdEnabled=!1"
        },
        {
          "kind": "js",
          "op": "replaceRegex",
          "requires": [
            "artplayerPluginAds({"
          ],
          "pattern": "this\\.prerollAdEnabled&&",
          "value": "false&&"
        },
        {
          "kind": "html",
          "op": "removeDivs",
          "bodyPattern": "<html[\\s>]",
          "pattern": "<div\\b[^>]*\\bclass\\s*=\\s*[\"\\'][^\"\\']*\\bad-item\\b[^\"\\']*[\"\\'][^>]*>"
        },
        {
          "kind": "html",
          "op": "replaceRegex",
          "bodyPattern": "<html[\\s>]",
          "pattern": "\\sdata-preroll-ad-[\\w-]+\\s*=\\s*(?:\"[^\"]*\"|\\'[^\\']*\\')",
          "flags": "ig",
          "value": ""
        }
      ]
    }
  ]
}
