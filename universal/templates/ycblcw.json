{
  "id": "ycblcw",
  "adapter": "declarative",
  "output": {
    "script": "ycblcw/ycblcw-ad-clean.js",
    "conf": "ycblcw/quantumult-x-snippet.conf"
  },
  "bindings": [
    {
      "domains": {
        "type": "exact",
        "names": [
          "ycblcw.com"
        ],
        "prefixes": [
          "",
          "www",
          "m"
        ]
      },
      "routes": [
        {
          "kind": "js",
          "path": "/dedg/cs13341\\.js(?:\\?.*)?$"
        },
        {
          "kind": "html",
          "path": "/(?:[^?#]*\\.html)?(?:\\?.*)?$"
        }
      ]
    }
  ],
  "actions": [
    {
      "kind": "js",
      "op": "setBody",
      "value": "/* Dedicated click-overlay and redirect advertising disabled. */"
    },
    {
      "kind": "html",
      "op": "removeElements",
      "requires": [
        "/template/buka/"
      ],
      "bodyPattern": "<html[\\s>]",
      "selector": {
        "tag": "script",
        "attr": "src",
        "pattern": "^(?:https?:)?(?://(?:www\\.|m\\.)?ycblcw\\.com)?/dedg/cs13341\\.js(?:[?#].*)?$"
      }
    },
    {
      "kind": "html",
      "op": "removeElements",
      "requires": [
        "/template/buka/"
      ],
      "bodyPattern": "<html[\\s>]",
      "selector": {
        "tag": "a",
        "attr": "href",
        "pattern": "^(?:https?:)?//app2\\.zstv47\\.com(?:[/?#].*)?$"
      }
    }
  ],
  "diagnostics": true
}
