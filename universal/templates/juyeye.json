{
  "id": "juyeye",
  "adapter": "declarative",
  "output": {
    "script": "juyeye/ad-clean.js",
    "conf": "juyeye/quantumult-x-snippet.conf"
  },
  "bindings": [
    {
      "domains": {
        "type": "exact",
        "names": [
          "www.juyeye.cc"
        ]
      },
      "routes": [
        {
          "kind": "html",
          "path": "/(?:index\\.html|(?:voddetail|vodplay|vodtype|vodshow|vodsearch)/[^/?#]+\\.html)?(?:\\?.*)?$"
        }
      ]
    }
  ],
  "actions": [
    {
      "kind": "html",
      "op": "removeInlineScripts",
      "requires": [
        "/mxtheme/js/home.js",
        "var maccms=",
        "www.juyeye.cc"
      ],
      "scriptRequires": [
        "!function(){function a(a){var b={",
        "new Function(b)()",
        "`.substr(10))",
        "YTTJ4TLR",
        "1n0n"
      ]
    },
    {
      "kind": "html",
      "op": "replaceInlineScripts",
      "requires": [
        "/mxtheme/js/home.js",
        "var maccms=",
        "www.juyeye.cc"
      ],
      "scriptRequires": [
        "var system = {};",
        "navigator.platform",
        "system.ispc =",
        "navigator.userAgent.match(/spider|iPad|iPhone|iPod|Android/i) == null;",
        "if (system.win || system.mac || system.ispc) {"
      ],
      "pairs": [
        [
          "window.location.href = \"../404.html\";",
          "/* For-ADM: desktop 404 redirect disabled. */",
          1
        ]
      ]
    }
  ]
}
