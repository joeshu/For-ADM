{
  "id": "yxxq",
  "adapter": "declarative",
  "output": {
    "script": "yxxq/ad-clean.js",
    "conf": "yxxq/quantumult-x-snippet.conf"
  },
  "bindings": [
    {
      "domains": {
        "type": "exact",
        "names": [
          "www.yxxq65.cc",
          "www.yxxq35.cc",
          "www.yxxq51.cc",
          "www.yxxq52.cc",
          "www.yxxq53.cc",
          "www.yxxq54.cc",
          "www.yxxq55.cc",
          "www.yxxq56.cc",
          "www.yxxq57.cc",
          "www.yxxq59.cc",
          "www.yxxq61.cc",
          "www.yxxq62.cc",
          "www.yxxq63.cc",
          "www.yxxq64.cc",
          "www.yxxq41.cc",
          "www.yxxq25.cc"
        ]
      },
      "routes": [
        {
          "kind": "html",
          "path": "/(?:[^?#]*\\.html)?(?:\\?.*)?$"
        },
        {
          "kind": "js",
          "path": "/static/js/(?:site-ads|lmgg-source-monitor|lmgg2-after-click)\\.js(?:\\?.*)?$"
        }
      ]
    }
  ],
  "actions": [
    {
      "kind": "html",
      "op": "removeElements",
      "requires": [
        "var maccms=",
        "/mxtheme/js/home.js",
        "/static/js/site-ads.js"
      ],
      "selector": {
        "tag": "li",
        "attr": "data-ad-slot",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    {
      "kind": "html",
      "op": "removeElements",
      "requires": [
        "var maccms=",
        "/mxtheme/js/home.js",
        "/static/js/site-ads.js"
      ],
      "selector": {
        "tag": "a",
        "attr": "data-ad-slot",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    {
      "kind": "html",
      "op": "removeElements",
      "requires": [
        "var maccms=",
        "/mxtheme/js/home.js",
        "/static/js/site-ads.js"
      ],
      "selector": {
        "tag": "div",
        "attr": "data-ad-slot",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    {
      "kind": "html",
      "op": "removeInlineScripts",
      "requires": [
        "var maccms=",
        "/mxtheme/js/home.js",
        "/static/js/site-ads.js"
      ],
      "scriptRequires": [
        "window.MAC_LMGG_SOURCE_MONITOR =",
        "raw_mobile_non_home",
        "mxpro_lmgg_raw"
      ]
    },
    {
      "kind": "html",
      "op": "removeInlineScripts",
      "requires": [
        "var maccms=",
        "/mxtheme/js/home.js",
        "/static/js/site-ads.js"
      ],
      "scriptRequires": [
        "window.MAC_LMGG_COOLDOWN =",
        "rawSourceB64:",
        "raw_mobile_non_home",
        "mxpro_lmgg_raw"
      ]
    },
    {
      "kind": "html",
      "op": "removeElements",
      "requires": [
        "var maccms=",
        "/mxtheme/js/home.js",
        "/static/js/site-ads.js"
      ],
      "selector": {
        "tag": "script",
        "attr": "src",
        "pattern": "^(?:(?:https?:)?//(?:www\\.yxxq(?:65|35|51|52|53|54|55|56|57|59|61|62|63|64|41|25)\\.cc))?/static/js/(?:lmgg-source-monitor|lmgg2-after-click)\\.js(?:\\?.*)?$"
      }
    },
    {
      "kind": "html",
      "op": "removeElements",
      "requires": [
        "var maccms=",
        "/mxtheme/js/home.js",
        "/static/js/site-ads.js"
      ],
      "selector": {
        "tag": "script",
        "attr": "src",
        "pattern": "^(?:(?:https?:)?//(?:www\\.yxxq(?:65|35|51|52|53|54|55|56|57|59|61|62|63|64|41|25)\\.cc))?/static/js/site-ads\\.js(?:\\?.*)?$"
      }
    },
    {
      "kind": "js",
      "op": "setBody",
      "requires": [
        "__MAC_SITE_ADS_READY__",
        "function initFloat()",
        "function initNavAds()",
        "function initAdModal()"
      ],
      "value": "/* For-ADM: verified YXXQ advertising module disabled. */"
    },
    {
      "kind": "js",
      "op": "setBody",
      "requires": [
        "window.MAC_LMGG_COOLDOWN",
        "function injectLmggRawIfAllowed()",
        "rawSourceB64",
        "function injectHtmlFallback(html)"
      ],
      "value": "/* For-ADM: verified YXXQ mobile ad injector disabled. */"
    },
    {
      "kind": "js",
      "op": "setBody",
      "requires": [
        "window.MAC_LMGG_SOURCE_MONITOR",
        "function trackTouch(event)",
        "function largestClickableArea()",
        "function sendAnalytics(action, props)"
      ],
      "value": "/* For-ADM: verified YXXQ mobile ad monitor disabled. */"
    }
  ],
  "diagnostics": true
}
