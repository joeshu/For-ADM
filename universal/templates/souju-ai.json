{
  "id": "souju-ai",
  "adapter": "souju",
  "output": {
    "script": "souju-ai/souju-ad-clean.js",
    "conf": "souju-ai/quantumult-x-snippet.conf"
  },
  "bindings": [
    {
      "domains": {
        "type": "exact",
        "names": [
          "ai.baipiaozhe.com",
          "souju.ai",
          "kanju3.com",
          "www.kanju3.com"
        ]
      },
      "routes": [
        {
          "kind": "json",
          "path": "/v1/[^?#]*(?:[?#].*)?$"
        },
        {
          "kind": "js",
          "path": "/assets/(?:global-player-host-[^/?]+|movie-card-runtime-[^/?]+|main-[^/?]+)\\.js(?:[?#].*)?$"
        }
      ]
    }
  ],
  "snapshotWhen": {
    "all": [
      {
        "path": "object",
        "equals": "app.experience_snapshot"
      },
      {
        "path": "placements",
        "type": "object"
      }
    ]
  },
  "snapshotOps": [
    {
      "op": "clearArray",
      "path": "placements.splash_screen.items"
    },
    {
      "op": "clearArray",
      "path": "placements.showcase_grid.items"
    },
    {
      "op": "set",
      "path": "placements.player_info.enabled",
      "value": false,
      "create": true,
      "when": {
        "path": "placements.player_info",
        "type": "object"
      }
    },
    {
      "op": "set",
      "path": "placements.player_info.default_ad_targeting.enabled",
      "value": false,
      "create": true,
      "when": {
        "path": "placements.player_info",
        "type": "object"
      }
    },
    {
      "op": "clearArray",
      "path": "placements.player_info.items"
    },
    {
      "op": "clearArray",
      "path": "placements.player_info.banner_items"
    },
    {
      "op": "clearArray",
      "path": "placements.player_info.grid_items"
    }
  ],
  "components": [
    {
      "prefix": "global-player-host-",
      "name": "Cp",
      "requires": [
        "qr(\"player_info\")",
        "creative_daily_rotation_limit"
      ]
    },
    {
      "prefix": "global-player-host-",
      "name": "ti",
      "requires": [
        "movie-player-info-ad-grid"
      ]
    },
    {
      "prefix": "global-player-host-",
      "name": "qu",
      "requires": [
        "movie-player-info-ad-banner-shell"
      ]
    },
    {
      "prefix": "main-",
      "name": "T0",
      "requires": [
        "app-startup-ad",
        "跳过"
      ]
    },
    {
      "prefix": "global-player-host-",
      "name": "Sp",
      "requires": [
        "qr(\"player_info\")",
        "movie-player-info-flip",
        "i.jsx(\"div\",{className:s,\"data-backdrop-effect\":r,children:e})"
      ],
      "replacement": "function Sp({children:e,frontBackdropEffect:r,frontClassName:s}){return i.jsx(\"div\",{className:s,\"data-backdrop-effect\":r,children:e})}"
    },
    {
      "prefix": "global-player-host-",
      "name": "em",
      "requires": [
        "movie-player-top-grid-ad",
        "播放器顶部广告"
      ]
    }
  ],
  "runtime": {
    "prefix": "movie-card-runtime-",
    "name": "As",
    "requires": [
      "splash_screen",
      "player_info",
      "showcase_grid"
    ],
    "pairs": [
      [
        "n=en(t.splash_screen,\"banner\")",
        "n=en({...t.splash_screen,items:[]},\"banner\")",
        1
      ],
      [
        "o=en(t.showcase_grid,\"grid\")",
        "o=en({...t.showcase_grid,items:[]},\"grid\")",
        1
      ],
      [
        "u=en({...a,layout:c===\"grid\"?\"grid\":\"banner\"})",
        "u=en({...a,items:[],layout:c===\"grid\"?\"grid\":\"banner\"})",
        1
      ],
      [
        "enabled:a.enabled!==!1",
        "enabled:!1",
        1
      ],
      [
        "banner_items:un(a.banner_items)??u.items",
        "banner_items:[]",
        1
      ],
      [
        "grid_items:un(a.grid_items)??u.items",
        "grid_items:[]",
        1
      ]
    ]
  }
}
