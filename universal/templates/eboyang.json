{
  "id": "eboyang",
  "adapter": "declarative",
  "output": {
    "script": "eboyang/ad-clean.js",
    "conf": "eboyang/quantumult-x-snippet.conf"
  },
  "bindings": [
    {
      "domains": {
        "type": "exact",
        "names": [
          "eboyang.com"
        ],
        "prefixes": [
          "",
          "www"
        ]
      },
      "routes": [
        {
          "kind": "js",
          "path": "/dedg/le1008\\.js(?:\\?.*)?$"
        },
        {
          "kind": "html",
          "path": "/(?:index\\.html|(?:bovod|bovideo|vodlist)/[0-9-]+\\.html|(?:search|gbook)\\.php)?(?:\\?.*)?$"
        }
      ]
    }
  ],
  "actions": [
    {
      "kind": "js",
      "op": "setBody",
      "requires": [
        "var c=",
        "new Function(t)()",
        "//le1008"
      ],
      "value": "/* For-ADM: dedicated eboyang bottom-overlay advertising loader disabled. */"
    },
    {
      "kind": "html",
      "op": "removeElements",
      "requires": [
        "一起看影院",
        "/templets/qiqino5/"
      ],
      "selector": {
        "tag": "script",
        "attr": "src",
        "pattern": "^(?:https?:)?(?://(?:www\\.)?eboyang\\.com)?/dedg/le1008\\.js(?:[?#].*)?$"
      }
    },
    {
      "kind": "html",
      "op": "removeElements",
      "requires": [
        "一起看影院",
        "/templets/qiqino5/"
      ],
      "selector": {
        "tag": "a",
        "attr": "href",
        "pattern": "^(?:https?:)?//app3\\.qingning9\\.com(?:[/?#].*)?$"
      }
    }
  ],
  "diagnostics": true
}
